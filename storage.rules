rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /pitches/{pitchId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/(default)/documents/pitches/$(pitchId))
                   && get(/databases/(default)/documents/pitches/$(pitchId)).data.ownerId == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
