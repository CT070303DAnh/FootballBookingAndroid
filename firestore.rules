// ============================================================
// FIRESTORE SECURITY RULES — Football Pitch Booking AI
// ============================================================
// Deploy: Firebase Console → Firestore → Rules → Paste → Publish
// Hoặc CLI: firebase deploy --only firestore:rules
//
// MÔ HÌNH PHÂN QUYỀN 3 ROLES:
//   customer       → Đặt sân, xem sân, viết review
//   owner          → CRUD sân của mình, duyệt đơn trên sân mình
//   admin          → Toàn quyền
//   owner_pending  → Chỉ đọc profile, chờ admin duyệt
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    // Kiểm tra user đã đăng nhập
    function isAuthenticated() {
      return request.auth != null;
    }

    // Lấy role của user hiện tại
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Kiểm tra user là Admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin'
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Kiểm tra user là Owner (đã duyệt)
    function isOwner() {
      return isActiveUser() && getUserRole() == 'owner';
    }

    // Kiểm tra user là Customer
    function isCustomer() {
      return isActiveUser() && getUserRole() == 'customer';
    }

    // Kiểm tra đúng chủ tài khoản
    function isOwnerOf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isActiveUser() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Calendar strings are interpreted in Vietnam time, never the device timezone.
    function startOfBooking(b) {
      let d = b.bookingDate.split('-');
      let t = b.startTime.split(':');
      return timestamp.date(int(d[0]), int(d[1]), int(d[2]))
        + duration.value(int(t[0]) * 60 + int(t[1]) - 420, 'm');
    }

    function defaultSlot(id) {
      return {
        'slot_1': ['06:00', '07:30', 0], 'slot_2': ['07:30', '09:00', 0],
        'slot_3': ['09:00', '10:30', 0], 'slot_4': ['14:00', '15:30', 0],
        'slot_5': ['15:30', '17:00', 0], 'slot_6': ['17:00', '18:30', 30000],
        'slot_7': ['18:30', '20:00', 50000], 'slot_8': ['20:00', '21:30', 50000],
        'slot_9': ['21:30', '23:00', 0]
      }.get(id, ['', '', -1]);
    }

    function validSlot(b) {
      let path = /databases/$(database)/documents/pitches/$(b.pitchId)/timeSlots/$(b.slotId);
      let fallback = defaultSlot(b.slotId);
      let slot = exists(path) ? get(path).data : {
        'startTime': fallback[0], 'endTime': fallback[1], 'surcharge': fallback[2],
        'isPeakHour': true, 'isActive': fallback[2] >= 0
      };
      return fallback[0] != '' && fallback[1] != ''
        && slot.startTime == fallback[0] && slot.endTime == fallback[1]
        && b.startTime == fallback[0] && b.endTime == fallback[1]
        && (exists(path) || get(/databases/$(database)/documents/pitches/$(b.pitchId)).data.get('useDefaultSlots', false))
        && slot.get('isActive', false) == true
        && b.surcharge == (slot.get('isPeakHour', false) ? slot.surcharge : 0)
        && b.surcharge >= 0;
    }

    // Five add-ons fit within Firestore's per-write document access budget.
    function servicePrice(services, i) {
      let s = services.size() > i ? services[i] : null;
      let data = s == null ? null : get(/databases/$(database)/documents/services/$(s.serviceId)).data;
      return s == null ? 0 : (
        data.isActive == true && data.price is number && data.price >= 0
        && s == {'serviceId': s.serviceId, 'serviceName': data.name, 'price': data.price}
        ? data.price : -1);
    }

    function validPrices(b) {
      let p = get(/databases/$(database)/documents/pitches/$(b.pitchId)).data;
      let a = servicePrice(b.services, 0);
      let c = servicePrice(b.services, 1);
      let d = servicePrice(b.services, 2);
      let e = servicePrice(b.services, 3);
      let f = servicePrice(b.services, 4);
      return p.get('bookingPolicyVersion', 0) == 2
        && p.status == 'available' && b.pitchOwnerId == p.ownerId
        && b.pitchName == p.name && b.pitchAddress == p.address && b.pitchType == p.type
        && b.basePrice is number && b.basePrice >= 0 && b.basePrice == p.basePrice
        && a >= 0 && c >= 0 && d >= 0 && e >= 0 && f >= 0
        && b.totalServicePrice == a + c + d + e + f
        && b.totalAmount == b.basePrice + b.surcharge + b.totalServicePrice;
    }

    function availability(b) {
      let path = /databases/$(database)/documents/pitches/$(b.pitchId)/availability/$(b.bookingDate);
      return exists(path) ? get(path).data.get('slots', {}).get(b.slotId, {}) : {};
    }

    function availabilityAfter(b, id, state) {
      let a = getAfter(/databases/$(database)/documents/pitches/$(b.pitchId)/availability/$(b.bookingDate)).data;
      return a.date == b.bookingDate && a.lastSlotId == b.slotId
        && a.slots[b.slotId] == {'status': state, 'bookingId': id};
    }

    function validNewBooking(b, id) {
      return b.keys().hasOnly(['bookingId', 'customerId', 'customerName', 'customerPhone',
        'pitchId', 'pitchName', 'pitchAddress', 'pitchType', 'pitchOwnerId', 'bookingDate',
        'slotId', 'startTime', 'endTime', 'services', 'basePrice', 'surcharge',
        'totalServicePrice', 'totalAmount', 'paymentStatus', 'paymentMethod',
        'vnpayTransactionId', 'bookingStatus', 'matchStatus', 'note', 'adminNote',
        'createdAt', 'updatedAt'])
        && b.bookingId == id && b.customerId == request.auth.uid
        && b.customerName is string && b.customerPhone is string
        && b.bookingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && b.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && b.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && b.startTime < b.endTime && startOfBooking(b) > request.time
        && b.services is list && b.services.size() <= 5
        && b.paymentStatus == 'unpaid' && b.paymentMethod in ['cash', 'payos', 'vnpay', 'pay_later']
        && b.get('vnpayTransactionId', null) == null
        && b.get('payosTransactionId', null) == null
        && b.get('adminNote', null) == null
        && b.bookingStatus == 'pending' && b.matchStatus == 'upcoming'
        && b.note is string && b.note.size() <= 2000
        && b.createdAt == request.time && b.updatedAt == request.time
        && validSlot(b) && validPrices(b)
        // The availability write checks the previous slot state. Reading it again
        // here would exceed the access budget for a five-service booking.
        && availabilityAfter(b, id, 'pending');
    }

    function managesBooking(b) {
      return isActiveUser() && (isAdmin() || (isOwner()
        && b.pitchOwnerId == request.auth.uid
        && get(/databases/$(database)/documents/pitches/$(b.pitchId)).data.ownerId == request.auth.uid));
    }

    function validBookingUpdate(before, after, id) {
      let changed = after.diff(before).affectedKeys();
      let manager = managesBooking(before);
      return (changed.hasOnly(['bookingStatus', 'adminNote', 'updatedAt'])
          && after.updatedAt == request.time
          && availability(before).get('bookingId', '') == id
          && ((before.bookingStatus == 'pending' && after.bookingStatus in ['approved', 'rejected'] && manager)
            || (before.bookingStatus in ['pending', 'approved'] && after.bookingStatus == 'cancelled'
              && isActiveUser() && before.customerId == request.auth.uid
              && changed.hasOnly(['bookingStatus', 'updatedAt']) && startOfBooking(before) > request.time))
          && availabilityAfter(before, after.bookingStatus == 'approved' ? id : null,
            after.bookingStatus == 'approved' ? 'booked' : 'available'))
        || (manager && before.bookingStatus == 'approved'
          && changed.hasOnly(['matchStatus', 'updatedAt'])
          && after.matchStatus in ['upcoming', 'playing', 'half_time', 'finished']);
    }

    // Only one slot may change, and its booking must change in the same atomic write.
    function validAvailability(pitchId, dateId, before, after) {
      let slotId = after.lastSlotId;
      let old = before.get('slots', {}).get(slotId, {'status': 'available', 'bookingId': null});
      let next = after.slots[slotId];
      let id = next.status == 'pending' ? next.bookingId : old.bookingId;
      let path = /databases/$(database)/documents/bookings/$(id);
      let b = getAfter(path).data;
      return isActiveUser() && after.diff(before).affectedKeys().hasOnly(['date', 'slots', 'lastSlotId'])
        && after.date == dateId && after.slots is map
        && after.slots.diff(before.get('slots', {})).affectedKeys().hasOnly([slotId])
        && next.keys().hasOnly(['status', 'bookingId'])
        && b.pitchId == pitchId && b.bookingDate == dateId && b.slotId == slotId
        && ((old.status == 'available' && next.status == 'pending'
            && !exists(path) && b.bookingStatus == 'pending' && next.bookingId == id)
          || (old.status in ['pending', 'booked'] && exists(path)
            && get(path).data.bookingStatus != b.bookingStatus
            && ((next.status == 'booked' && next.bookingId == id && b.bookingStatus == 'approved')
              || (next.status == 'available' && next.bookingId == null && b.bookingStatus in ['cancelled', 'rejected']))));
    }


    // ===== COLLECTION: users =====
    match /users/{userId} {

      // Private profiles contain contact details and FCM tokens.
      allow get: if isOwnerOf(userId) || isAdmin();
      allow list: if isAdmin();

      // Client chỉ được tạo tài khoản thường hoặc yêu cầu làm chủ sân.
      // Admin đầu tiên phải được cấp quyền bằng Console/Admin SDK tin cậy.
      allow create: if isOwnerOf(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['customer', 'owner_pending']
                    && request.resource.data.status == 'active';

      // diff kiểm tra cả trường bị thêm/xóa, không chỉ trường có trong request.
      // User vẫn được sửa hồ sơ và đăng ký FCM, nhưng không được tự đổi quyền.
      allow update: if (isActiveUser() && isOwnerOf(userId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['displayName', 'phoneNumber', 'avatarUrl',
                                      'fcmToken', 'updatedAt']))
                    || (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['role', 'status', 'updatedAt'])
                        && request.resource.data.role in ['customer', 'owner_pending', 'owner', 'admin']
                        && request.resource.data.status in ['active', 'blocked']);
      allow delete: if isAdmin();

      // Sub-collection: notifications
      match /notifications/{notifId} {
        allow read, write: if (isActiveUser() && isOwnerOf(userId)) || isAdmin();
      }

      // Sub-collection: bookingHistory
      match /bookingHistory/{histId} {
        allow read: if (isActiveUser() && isOwnerOf(userId)) || isAdmin();
        allow create: if isActiveUser() && isOwnerOf(userId)
          && request.resource.data == {'bookingRef': histId}
          && getAfter(/databases/$(database)/documents/bookings/$(histId)).data.customerId == userId;
      }
    }


    // ===== COLLECTION: pitches =====
    match /pitches/{pitchId} {

      // Tất cả user đã login đều đọc được (Customer cần xem sân)
      allow read: if isActiveUser();

      // Admin: toàn quyền CRUD
      // Owner: chỉ tạo/sửa/xóa sân CÓ ownerId == uid của mình
      allow create: if isAdmin()
                    || (isActiveUser() && isOwner() && request.resource.data.ownerId == request.auth.uid
                      && request.resource.data.get('bookingPolicyVersion', 0) == 0);

      allow update: if isAdmin()
                    || (isActiveUser() && isOwner() && resource.data.ownerId == request.auth.uid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['ownerId', 'bookingPolicyVersion', 'useDefaultSlots']));

      // Xóa (soft delete via status update — nhưng nếu cần hard delete)
      allow delete: if isAdmin();

      // Sub-collection: timeSlots
      match /timeSlots/{slotId} {
        allow read: if isActiveUser();
        // Disable new bookings before changing a schedule; revalidate its locks before enabling v2.
        allow write: if isAdmin()
          && getAfter(/databases/$(database)/documents/pitches/$(pitchId)).data.get('bookingPolicyVersion', 0) != 2;
      }

      // Sub-collection: availability (trạng thái slot theo ngày)
      match /availability/{dateId} {
        allow read: if isActiveUser();
        allow create: if validAvailability(pitchId, dateId, {}, request.resource.data);
        allow update: if validAvailability(pitchId, dateId, resource.data, request.resource.data);
        allow delete: if false;
      }
    }


    // ===== COLLECTION: bookings =====
    match /bookings/{bookingId} {

      // Availability is public to active users; booking details are private.
      allow read: if isActiveUser() && (isAdmin()
        || resource.data.customerId == request.auth.uid
        || (isOwner() && resource.data.pitchOwnerId == request.auth.uid));

      // Customer tạo đơn mới (pitchOwnerId được gắn tự động)
      allow create: if isActiveUser() && isCustomer()
                    && validNewBooking(request.resource.data, bookingId);

      // Chỉ chuyển trạng thái được phép; giá, danh tính và thanh toán là bất biến.
      // Mọi duyệt/hủy/từ chối phải cập nhật đúng khóa lịch cùng giao dịch.
      allow update: if validBookingUpdate(resource.data, request.resource.data, bookingId);

      allow delete: if false;
    }


    // Payment sessions and bank-transaction deduplication are server-only.
    match /payment_sessions/{paymentId} {
      allow read, write: if false;
    }
    match /vnpay_transactions/{transactionId} {
      allow read, write: if false;
    }

    // ===== COLLECTION: reviews =====
    match /reviews/{reviewId} {

      // Ai đã login đều đọc được (hiển thị trên PitchDetail)
      allow read: if isActiveUser();

      // Chỉ Customer mới viết review, và phải là chính mình
      allow create: if isCustomer()
                    && request.resource.data.keys().hasOnly([
                      'bookingId', 'customerId', 'customerName', 'customerAvatar',
                      'pitchId', 'rating', 'comment', 'imageUrls', 'createdAt'
                    ])
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.bookingId is string
                    && request.resource.data.pitchId is string
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 1000
                    && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == request.auth.uid
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.pitchId == request.resource.data.pitchId
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.bookingStatus == 'approved'
                    && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.matchStatus == 'finished';

      // Chỉ chủ review hoặc Admin mới sửa/xóa
      allow update: if isCustomer()
                    && resource.data.customerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['rating', 'comment', 'imageUrls']);
      allow delete: if isAdmin()
                    || (isActiveUser() && resource.data.customerId == request.auth.uid);
    }


    // ===== COLLECTION: services =====
    match /services/{serviceId} {
      // Dịch vụ kèm theo (nước, bóng, áo...) — ai cũng đọc
      allow read: if isActiveUser();
      // Chỉ Admin hoặc Owner tạo/sửa
      allow write: if isAdmin();
    }


    // ===== COLLECTION: employees =====
    match /employees/{empId} {
      // Chỉ Admin xem & quản lý nhân viên
      allow read, write: if isAdmin();
    }


    // ===== COLLECTION: fcm_queue =====
    // Queue xử lý bởi Cloud Functions — gửi push notification
    match /fcm_queue/{queueId} {
      // Hệ thống ghi (từ client khi đặt sân, duyệt đơn...)
      allow create: if isActiveUser()
                    && request.resource.data.keys().hasOnly([
                      'type', 'bookingId', 'customerId', 'customerName',
                      'pitchName', 'time', 'date', 'ownerId', 'processed', 'createdAt'
                    ])
                    && request.resource.data.type is string
                    && request.resource.data.bookingId is string
                    && request.resource.data.customerId is string
                    && request.resource.data.processed == false
                    && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == request.resource.data.customerId;
      // Cloud Functions đọc & đánh dấu processed
      allow read, update, delete: if false;
    }

  }
}
