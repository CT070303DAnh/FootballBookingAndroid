HOST=0.0.0.0
PORT=8000
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json

# Server only. Never copy the secret into Android/local.properties/BuildConfig.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_GATEWAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-api.example.com/payments/vnpay/return
# Public IP of the backend server for QueryDR (not an arbitrary X-Forwarded-For value).
VNPAY_SERVER_IP=
# Register https://your-api.example.com/payments/vnpay/ipn with VNPay.
