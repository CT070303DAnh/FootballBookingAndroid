<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/transparent"
        app:title="Tin nhắn"
        app:titleTextColor="@color/white" />

    <TextView
        android:id="@+id/tv_chat_inbox_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Trao đổi nhanh về các đơn đặt sân đã duyệt"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_chat_inbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        app:indicatorColor="@color/primary_light"
        app:trackColor="@color/divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_inbox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:padding="16dp"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/tv_chat_inbox_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="Chưa có cuộc trò chuyện nào\nMở chat từ một đơn đặt sân đã duyệt để bắt đầu."
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
