<?xml version="1.0" encoding="utf-8"?>
<!-- item_admin_pitch_card.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Ảnh thumbnail -->
        <ImageView
            android:id="@+id/iv_admin_pitch_thumb"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh sân"
            tools:src="@android:drawable/ic_menu_compass" />

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_admin_pitch_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Sân bóng Mỹ Đình A" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_admin_pitch_type"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="7 người"
                    app:chipBackgroundColor="@color/background_surface"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="7 người" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_admin_pitch_status"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:text="Hoạt động"
                    app:chipBackgroundColor="@color/status_approved"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    tools:text="Hoạt động" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_admin_pitch_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                tools:text="150.000đ / giờ" />

            <TextView
                android:id="@+id/tv_admin_pitch_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="⭐ 4.8  (32 đánh giá)" />
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_admin_edit_pitch"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="@color/primary_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_admin_delete_pitch"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/status_rejected" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
