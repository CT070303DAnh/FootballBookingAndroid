<?xml version="1.0" encoding="utf-8"?>
<!-- item_ai_pitch_card.xml — Card gợi ý sân của AI với ranking + score -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Ảnh sân -->
        <ImageView
            android:id="@+id/iv_ai_pitch_image"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh sân bóng"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@android:drawable/ic_menu_compass" />

        <!-- Gradient overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/bg_image_overlay"
            app:layout_constraintBottom_toBottomOf="@+id/iv_ai_pitch_image"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ===== RANKING BADGE: #1, #2, #3 ===== -->
        <TextView
            android:id="@+id/tv_ai_rank"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_margin="10dp"
            android:background="@drawable/bg_rank_badge"
            app:layout_constraintTop_toTopOf="@+id/iv_ai_pitch_image"
            app:layout_constraintStart_toStartOf="@+id/iv_ai_pitch_image"
            tools:text="#1" />

        <!-- ===== AI SCORE CIRCLE ===== -->
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_score_circle"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="@+id/iv_ai_pitch_image"
            app:layout_constraintEnd_toEndOf="@+id/iv_ai_pitch_image">

            <TextView
                android:id="@+id/tv_ai_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="95%" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI"
                android:textColor="@color/accent"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:id="@+id/layout_ai_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@+id/iv_ai_pitch_image"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Tên sân -->
            <TextView
                android:id="@+id/tv_ai_pitch_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Sân bóng Mỹ Đình A" />

            <!-- Lý do AI gợi ý -->
            <TextView
                android:id="@+id/tv_ai_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp"
                tools:text="☀️ Trời quang, 1.2km từ bạn, ⭐ Rating 4.8" />

            <!-- Score breakdown mini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <!-- Distance -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📍 Gần" android:textColor="@color/text_hint" android:textSize="10sp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_distance"
                        android:layout_width="match_parent" android:layout_height="4dp"
                        android:indeterminate="false"
                        app:indicatorColor="@color/primary_light"
                        app:trackColor="@color/divider"
                        app:trackCornerRadius="2dp"
                        tools:progress="85" />
                </LinearLayout>

                <View android:layout_width="4dp" android:layout_height="1dp" />

                <!-- Weather -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="☁️ Thời tiết" android:textColor="@color/text_hint" android:textSize="10sp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_weather"
                        android:layout_width="match_parent" android:layout_height="4dp"
                        android:indeterminate="false"
                        app:indicatorColor="@color/accent"
                        app:trackColor="@color/divider"
                        app:trackCornerRadius="2dp"
                        tools:progress="90" />
                </LinearLayout>

                <View android:layout_width="4dp" android:layout_height="1dp" />

                <!-- Rating -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⭐ Rating" android:textColor="@color/text_hint" android:textSize="10sp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_rating"
                        android:layout_width="match_parent" android:layout_height="4dp"
                        android:indeterminate="false"
                        app:indicatorColor="@color/star_filled"
                        app:trackColor="@color/divider"
                        app:trackCornerRadius="2dp"
                        tools:progress="96" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row: Giá + Khoảng cách + Nút đặt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_ai_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="150.000đ/h" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_book"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đặt sân"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
