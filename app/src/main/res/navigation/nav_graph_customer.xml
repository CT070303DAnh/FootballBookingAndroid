<?xml version="1.0" encoding="utf-8"?>
<!-- navigation/nav_graph_customer.xml -->
<!-- Navigation Graph cho Customer — dùng với Navigation Component -->
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_customer"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.footballbooking.ui.customer.home.HomeFragment"
        android:label="Trang chủ" />

    <fragment
        android:id="@+id/nav_map"
        android:name="com.example.footballbooking.ui.customer.pitch.PitchMapFragment"
        android:label="Bản đồ" />

    <fragment
        android:id="@+id/nav_ai"
        android:name="com.example.footballbooking.ui.customer.ai.AiSuggestionFragment"
        android:label="AI Gợi ý" />

    <fragment
        android:id="@+id/nav_history"
        android:name="com.example.footballbooking.ui.customer.booking.BookingHistoryFragment"
        android:label="Lịch sử đặt sân" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.footballbooking.ui.customer.profile.ProfileFragment"
        android:label="Hồ sơ" />

</navigation>
